# Copy this file to ".env" in the project root and paste your real values there.
# NEVER commit your ".env" file to GitHub (".env" is already ignored in .gitignore).

# 1. Google AI Studio / Gemini API (Script, Narration / Gemini TTS)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Cloudflare Workers AI (FLUX Image Generation)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# 3. Kaggle (Optional for CLI/API automation; Wan 2.2 & ACE-Step also run in Kaggle browser notebooks)
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_api_key_here
